{
  "manifest_version": 3,
  "name": "Unlock flow",
  "version": "1.4.6",
  "description": "Unlock Flow interface for Google Flow and Playground.",
  "author": "TotalCodeAdmin (https://t.me/TotalCodeAdmin)",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://playground.google/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Unlock flow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://playground.google/*"
      ],
      "js": [
        "status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "unlock-flow@totalcode",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
